{
  "id": "php-ci3",
  "detect": [
    "composer.json"
  ],
  "steps": [
    {
      "id": "migrate",
      "run": "${cmd.migrate}",
      "provides": "migrate",
      "phase": "fast"
    },
    {
      "id": "unit",
      "run": "${cmd.test}"
    }
  ],
  "effects": [
    {
      "id": "migrate",
      "glyph": "\u2699",
      "hint": "one bullet per DDL effect: `<table>`: +|~|- `<column>` <type>"
    }
  ],
  "guards": [
    {
      "id": "migrations",
      "phase": "pre-edit",
      "script": "php-ci3/migrations.mjs"
    },
    {
      "id": "php-lint",
      "phase": "post-edit",
      "script": "php-ci3/php-lint.mjs"
    }
  ]
}
